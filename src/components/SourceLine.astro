---
import { fuente } from '../lib/datos';
import { useI18n } from '../i18n';
interface Props { ids: string[]; nota?: string }
const { ids, nota } = Astro.props;
const { t, tr, href } = useI18n(Astro.url);
const lista = [...new Set(ids)].map(fuente);
---
<p class="source-line">
  <span>{t.comun.fonteLinea(lista.length)}: </span>
  {lista.map((f, i) => (
    <>
      <a href={href(`fuentes/#${f.id}`)}>{tr(f.organismo)}</a>{i < lista.length - 1 ? ' · ' : ''}
    </>
  ))}
  {nota && <span>. {nota}</span>}
</p>
