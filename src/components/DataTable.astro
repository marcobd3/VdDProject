---
interface Props { caption: string; head: string[]; rows: (string | number)[][]; align?: ('l' | 'r')[] }
import { useI18n } from '../i18n';
const { caption, head, rows, align = [] } = Astro.props;
const { t } = useI18n(Astro.url);
---
<details class="data-table">
  <summary>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/></svg>
    {t.comun.verTaboa}
  </summary>
  <table>
    <caption class="sr-only">{caption}</caption>
    <thead><tr>{head.map((h, i) => <th scope="col" class={align[i] === 'r' ? 'r' : undefined}>{h}</th>)}</tr></thead>
    <tbody>
      {rows.map((r) => <tr>{r.map((c, i) => (i === 0 ? <th scope="row">{c}</th> : <td class={align[i] === 'r' ? 'r' : undefined}>{c}</td>))}</tr>)}
    </tbody>
  </table>
</details>
