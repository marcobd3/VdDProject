---
import Base from '../layouts/Base.astro';
import { datos, fuentes, numFuente, tipos, url } from '../lib/datos';

const temas: Record<string, string> = {
  poblacion: 'población', economia: 'economía', educacion: 'educación', politica: 'política', historia: 'historia',
  territorio: 'territorio', patrimonio: 'patrimonio', naturaleza: 'naturaleza', servicios: 'servicios', fiestas: 'fiestas', actualidad: 'actualidad',
};
const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
const conteo = fuentes.reduce<Record<string, number>>((a, f) => ((a[f.tipo] = (a[f.tipo] ?? 0) + 1), a), {});
---
<Base title="Catálogo de fuentes" current="fuentes"
  description={`Las ${fuentes.length} fuentes públicas usadas para documentar Val do Dubra: INE, IGE, Agencia Tributaria, BOE, Xunta, Concello, enciclopedias y prensa.`}>
  <div class="wrap" style="padding-block:clamp(2.5rem,5vw,4.5rem) 4rem">
    <header class="chapter-head" style="margin-bottom:2rem">
      <div class="chapter-num" aria-hidden="true">§</div>
      <div>
        <p class="kicker">Transparencia</p>
        <h1 style="font-size:var(--step-4);margin-top:.35rem">Catálogo de fuentes</h1>
        <p class="lede" style="margin-top:1rem;max-width:56ch">
          Todas las fuentes en un mismo sitio. Cada dato de la web enlaza aquí con su número. Prioriza las fuentes oficiales y usa el resto para contrastar o completar.
        </p>
      </div>
    </header>

    <div class="filters" role="search">
      <label for="q" class="sr-only">Buscar fuentes</label>
      <input id="q" type="search" placeholder="Buscar: INE, población, fiestas…" data-sources-q autocomplete="off" />
      <div role="group" aria-label="Filtrar por tipo" style="display:flex;flex-wrap:wrap;gap:.5rem">
        <button class="chip" type="button" data-tipo="todos" aria-pressed="true">Todas ({fuentes.length})</button>
        {Object.entries(conteo).map(([t, c]) => <button class="chip" type="button" data-tipo={t} aria-pressed="false">{tipos[t]} ({c})</button>)}
      </div>
    </div>
    <p class="small muted" aria-live="polite" style="margin-bottom:1rem"><span data-sources-count>{fuentes.length}</span> fuentes visibles</p>

    <ol class="source-list" data-sources>
      {fuentes.map((f) => (
        <li class="source-item" id={f.id} data-item data-tipo-item={f.tipo}
          data-text={norm(`${f.nombre} ${f.organismo} ${f.temas.map((t) => temas[t] ?? t).join(' ')} ${f.nota}`)}>
          <span class="sid">{numFuente(f.id)}</span>
          <div>
            <h2><a href={f.url} rel="noopener">{f.nombre} <span aria-hidden="true">↗</span></a></h2>
            <p class="org">{f.organismo}</p>
            {f.nota && <p class="note">{f.nota}</p>}
          </div>
          <div class="badges">
            <span class={`badge ${f.tipo}`}>{tipos[f.tipo]}</span>
            {f.temas.map((t) => <span class="badge">{temas[t] ?? t}</span>)}
          </div>
        </li>
      ))}
    </ol>

    <section class="block" aria-labelledby="ampliar">
      <h2 id="ampliar" class="h-section" style="font-size:var(--step-3)">Fuentes para ampliar</h2>
      <p class="block-intro" style="margin-top:.5rem">Fuentes oficiales con más detalle sobre el municipio, todavía sin incorporar a esta web. Son el siguiente paso para ampliar los datos.</p>
      <div class="grid-cards">
        {datos.fuentesParaAmpliar.map((f) => (
          <a class="card" href={f.url} rel="noopener" style="text-decoration:none">
            <span class="tag">{f.organismo}</span>
            <h3 style="font-size:var(--step-1)">{f.nombre} ↗</h3>
            <p>{f.uso}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="block callout" aria-label="Metodología">
      <p><strong>Metodología.</strong> {datos.meta.nota} Las cifras se revisaron por última vez el {new Date(datos.meta.actualizado).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}. Si detectas un error o conoces una fuente mejor, escribe al equipo del proyecto. Los datos también están en <a href={url('datos/')}>formato abierto</a>.</p>
    </section>
  </div>
</Base>
